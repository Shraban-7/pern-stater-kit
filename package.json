{
  "name": "pern-starter",
  "version": "1.0.0",
  "description": "Production-ready PERN stack project generator",
  "keywords": [
    "pern",
    "postgres",
    "express",
    "react",
    "nodejs",
    "starter",
    "generator",
    "cli",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "pern-starter": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:cli": "tsx src/cli/index.ts",
    "build": "tsup",
    "build:web": "vite build",
    "build:vercel": "npm run build:web",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "commander": "^13.1.0",
    "handlebars": "^4.7.9",
    "jszip": "^3.10.1",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "prettier": "^3.9.6",
    "semver": "^7.8.5",
    "yaml": "^2.9.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^3.2.7"
  }
}
