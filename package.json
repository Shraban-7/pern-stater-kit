{
  "name": "pern-starter",
  "version": "1.0.0",
  "description": "Production-ready PERN stack project generator",
  "keywords": [
    "pern",
    "postgres",
    "express",
    "react",
    "nodejs",
    "starter",
    "generator",
    "cli",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "pern-starter": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:cli": "tsx src/cli/index.ts",
    "build": "tsup",
    "build:web": "vite build",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "commander": "^13.1.0",
    "handlebars": "^4.7.8",
    "jszip": "^3.10.1",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "prettier": "^3.5.3",
    "semver": "^7.7.1",
    "yaml": "^2.7.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@vercel/node": "^5.1.14",
    "@types/node": "^22.13.14",
    "@types/semver": "^7.5.8",
    "eslint": "^9.23.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "vite": "^6.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "vitest": "^3.0.9"
  }
}
